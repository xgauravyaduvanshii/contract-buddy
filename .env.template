# ─────────────────────────────────────────────────────────────
# ContractBuddy environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
#   cp .env.template .env
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database
# Postgres URL. If the password contains special chars (e.g. @), URL-encode them (@ -> %40).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/contractbuddy?schema=public"

# Auth
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-secret"
SESSION_COOKIE_NAME="cb_session"

# XRouter (AI gateway)
XROUTER_BASE_URL="https://urmate.tech/api/xrouter/v1"
XROUTER_API_KEY="xr_replace_with_real_key"

# SMTP (transactional email + password-reset OTP). Blank SMTP_HOST logs emails to console in dev.
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
SMTP_USER="no-reply@yourdomain.com"
SMTP_PASS="smtp-password"
SMTP_SECURE="false"
MAIL_FROM="ContractBuddy <no-reply@yourdomain.com>"

# Social login (leave blank to disable the corresponding provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
